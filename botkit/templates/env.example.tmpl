# {{BOT_NAME}} 的密钥配置
#
# 复制成 .env 再填真实值：
#     copy .env.example .env      （Windows）
#     cp .env.example .env        （macOS / Linux）
#
# .env 不要提交 git（仓库根目录的 .gitignore 已经排除了）。

# --- 企业微信 Agent（凭证从企微后台获取） ---
# 企微管理后台 → 智能机器人 → API模式 → 长连接
WECHAT_BOT_ID=
WECHAT_BOT_SECRET=

# --- LLM ---
# bot.yaml 里 llm.client=openai（默认）时，这里填到 /v1 为止，
# 不要带 /chat/completions —— 官方 SDK 会自己拼路径。
# 若改用 llm.client=aiohttp，则要填完整端点。
LLM_API_URL=https://xxx.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.7-plus

# --- MCP 工具服务端 ---
# 不用手填。在配置页「工具」页每个服务端的「地址」框填明文 URL，
# 保存时会自动写进 .env，占位符名按服务端生成（main → MCP_URL_MAIN，
# crm → MCP_URL_CRM，以此类推）。手动填也行：
MCP_URL=https://your-mcp-host:8081/mcp
