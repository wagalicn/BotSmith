# {{BOT_NAME}} Agent配置
#
# 密钥一律用 ${VAR} 占位，实际值放同目录的 .env（.env 不提交 git）。
# 这个文件本身不含密钥，可以放心提交，也方便同事之间抄。
#
# 改完用 `python -m botkit validate {{BOT_DIR}}` 检查，
# 再用 `python -m botkit run {{BOT_DIR}}` 启动。

name: {{BOT_NAME}}

# ---------------------------------------------------------------------------
# 企业微信 Agent 凭证（必填）
# 从企微管理后台 → 智能机器人 → API模式 → 长连接 获取
# ---------------------------------------------------------------------------
wecom:
  bot_id: ${WECHAT_BOT_ID}
  bot_secret: ${WECHAT_BOT_SECRET}

# ---------------------------------------------------------------------------
# LLM 配置（必填）
#
# client 两个后端怎么选：
#
#   openai （默认，推荐）用 openai 官方 SDK。自带重试、超时、连接池和
#           类型化的 tool_calls。绝大多数情况用这个。
#           ⚠ api_url 填到 /v1 为止，不要带 /chat/completions，
#             SDK 会自己拼路径。填错了 validate 会提示你。
#           例：https://xxx.maas.aliyuncs.com/compatible-mode/v1
#
#   aiohttp 裸 HTTP POST。用于那些"号称兼容 OpenAI"但其实不太规范的
#           自建端点或网关：响应里多塞字段、tool_calls 结构有偏差、
#           鉴权头非标准、choices 缺字段等。这些情况官方 SDK 会在
#           pydantic 校验阶段直接抛错，拿不到原始响应；裸 HTTP 能把
#           原始 JSON 拿到手自己兜，排查时也能直接看到对方返了什么。
#           代价是没有自动重试。
#           ⚠ api_url 填完整端点（含 /chat/completions）。
#
# max_tool_rounds 是一轮对话里最多允许模型调几轮工具，防止它打转。
# ---------------------------------------------------------------------------
llm:
  client: openai
  api_url: ${LLM_API_URL}
  api_key: ${LLM_API_KEY}
  model: ${LLM_MODEL}
  timeout_seconds: 60
  max_tool_rounds: 6

# ---------------------------------------------------------------------------
# 提示词（必填）
# 角色、任务、约束都写在 prompt.md 里，方便单独 review 和改。
# 也可以改成 inline: | 直接写在这儿，但长提示词不建议。
# ---------------------------------------------------------------------------
prompt:
  file: prompt.md

# ---------------------------------------------------------------------------
# MCP 工具来源（可选）
#
# 不接任何工具时可以把整个 mcp 段删掉，或写成 servers: []，
# 这样Agent就是纯 LLM 对话。需要让Agent能查/办业务时才配 server。
#
# name            自取，用于日志和工具路由
# url             MCP 服务端地址（Streamable HTTP）。这里存 ${MCP_URL} 这类
#                 占位符，真实地址不写进本文件；在配置页「工具」页每个服务端的
#                 「地址」框直接填明文，保存时自动落到同目录 .env（变量名按服务端
#                 生成，如 main → MCP_URL_MAIN、crm → MCP_URL_CRM）。
# identity_header 把当前用户身份透传给服务端的请求头名。
#                 服务端不需要身份就留空或删掉这一行。
# allow_tools     白名单。省略或留空 = 该服务端所有工具都暴露给 LLM。
#                 ⚠ 中台工具多的时候强烈建议配白名单：工具越少
#                   LLM 越不容易选错，token 也省。
# deny_tools      黑名单，优先级高于白名单。
#
# 可以配多个 server，工具会合并。工具名重复时保留先出现的那个并打警告。
# ---------------------------------------------------------------------------
mcp:
  servers:
    - name: main
      url: ${MCP_URL}
      identity_header: X-MCP-Identity
      allow_tools: []
      # deny_tools: []
    # - name: crm
    #   url: ${CRM_MCP_URL}
    #   allow_tools: [get_customer]

# ---------------------------------------------------------------------------
# 身份（可选整段省略）
#
# source   wecom_userid = 直接用企微消息里的 from.userid（默认）
#          hook         = 由 hooks.py 的 resolve_identity 决定
#                         （企微 userid 不是业务工号、需要映射时用）
#
# pattern  身份格式校验，是个安全阀。不匹配就直接回
#          messages.identity_invalid，不会进 LLM、不会碰工具。
#          省略则不校验。例如工号形如 L220104 / M220104。
#
# inject   安全边界。把可信身份强制写进指定工具的指定参数，
#          覆盖 LLM 生成的值。没有这个，LLM 可能编造别人的工号
#          去替他提工单。凡是"代表某人操作"的工具都该配上。
# ---------------------------------------------------------------------------
identity:
  source: wecom_userid
  pattern: "^[LM]\\d{6}$"
  inject: []
  # inject:
  #   - tool: create_it_ticket
  #     arg: work_code

# ---------------------------------------------------------------------------
# 会话上下文（可选整段省略，下面就是默认值）
#
# scope 决定谁跟谁共享对话历史：
#   group_user 群内按人隔离，单聊按人。同一群里两个人互不干扰。多数场景用这个
#   group      整个群共享一份上下文，适合协作类场景
#   user       同一个人在所有会话里共享（跨群记忆）
#
# max_turns   保留最近几轮。太大会让 token 涨得很快
# ttl_seconds 空闲多久后忘掉这个会话
# ---------------------------------------------------------------------------
session:
  scope: group_user
  max_turns: 10
  ttl_seconds: 1800

# ---------------------------------------------------------------------------
# 文案（可选，逐条覆盖，没写的用框架默认值）
#
# tool_progress 是调工具时推给用户的中间进度提示，按工具名匹配，
# 没匹配到的走 default。工具慢的时候有个提示，用户体验差别很大。
# ---------------------------------------------------------------------------
messages:
  welcome: "你好，我是 {{BOT_NAME}}。@我描述一下你的需求，我来帮你处理。"
  empty_input: "请描述一下你的需求。"
  thinking: "正在处理，请稍候..."
  reset_done: "已清空对话，我们重新开始吧。"
  error: "抱歉，处理过程中发生异常，请查看Agent日志。"
  identity_invalid: "无法识别你的工号，请联系管理员确认企微账号配置。"
  tool_rounds_exceeded: "处理超时（工具调用轮次过多），请把问题描述得更具体一些再试。"
  # reply_suffix 自动追加到每条 LLM 正常回复末尾（署名、帮助入口等）。
  # 只作用于模型回复，不影响报错/拦截等固定文案。留空或删掉 = 不追加。
  # reply_suffix: "\n\n—— {{BOT_NAME}}"
  reset_keywords:
    - 重新开始
    - 重来
    - 清空对话
    - 重置
    - reset
  tool_progress:
    default: "正在调用工具..."
    # your_tool_name: "正在查询..."

# ---------------------------------------------------------------------------
# 前置拦截（可选整段省略）
#
# 用户消息命中规则时，直接用 reply 回复，不进 LLM —— 快、省 token、答案稳定。
# 适合帮助菜单、固定问答、敏感词提示这类不需要模型参与的场景。
#
# 每条规则：
#   match       精确匹配（去空格后完全相等）的关键词列表
#   match_regex 正则匹配（匹配到子串即命中）
#   reply       命中时的回复文本（必填）
# match / match_regex 至少配一个；两个都配时任一命中即可。
#
# 优先级：重置关键词 > 这里的 intercepts > on_message hook > LLM。
# ---------------------------------------------------------------------------
# intercepts:
#   - match: ["帮助", "help", "?"]
#     reply: "我能帮你：\n1. xxx\n2. yyy\n直接描述需求即可。"
#   - match_regex: "^在吗[?？]?$"
#     reply: "在的，请直接说你的需求。"

# ---------------------------------------------------------------------------
# 代码扩展点（可选）
# 纯配置搞不定的需求才用。文件里全注释掉也没问题。
# ---------------------------------------------------------------------------
hooks:
  file: hooks.py

logging:
  level: INFO
