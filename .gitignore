# 密钥，绝对不能提交
.env
*.env
!.env.example

# 门户用户表（含密码哈希），不进 git
users.json
node_modules/
# 门户前端构建产物（由 npm build 生成，发布时打进 wheel）
botkit/portal/static/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# 临时文件
_*.txt
_tmp*
门户架构决策.md


# 删除Agent的回收站（本地找回用，不进 git）
# 忽略 bots 目录下的所有Agent配置，但保留目录结构
bots/*
!bots/.gitkeep

# 用量落盘目录（含用户标识），任何 Agent 的都不进 git。
# bots/* 已整体忽略，这条是显式兜底：即便将来把某个示例 Agent 纳入版本管理，
# 它的 usage/ 仍被排除。
usage/
**/usage/*.jsonl
demandDoc/
.vscode
